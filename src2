-- ==================== MOVEMENT TAB ====================
function loadMovementTab()
    createSection("═══ 🚀 MOVEMENT FEATURES ═══")
    
    -- FLY MODE
    local flyBtn = createButton("FLY MODE [F]", "✈️")
    flyBtn.MouseButton1Click:Connect(function()
        settings.flying = not settings.flying
        
        if settings.flying then
            flyBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
            notify("Fly Mode: ON", Color3.fromRGB(0, 255, 0))
            
            local bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bodyVelocity.Parent = humanoidRootPart
            
            local bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.P = 9e4
            bodyGyro.Parent = humanoidRootPart
            
            spawn(function()
                while settings.flying do
                    local camera = workspace.CurrentCamera
                    local direction = Vector3.new(0, 0, 0)
                    
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                        direction = direction + (camera.CFrame.LookVector * settings.flySpeed)
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                        direction = direction - (camera.CFrame.LookVector * settings.flySpeed)
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                        direction = direction - (camera.CFrame.RightVector * settings.flySpeed)
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                        direction = direction + (camera.CFrame.RightVector * settings.flySpeed)
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                        direction = direction + Vector3.new(0, settings.flySpeed, 0)
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                        direction = direction - Vector3.new(0, settings.flySpeed, 0)
                    end
                    
                    if bodyVelocity then bodyVelocity.Velocity = direction end
                    if bodyGyro then bodyGyro.CFrame = camera.CFrame end
                    wait()
                end
                
                if bodyVelocity then bodyVelocity:Destroy() end
                if bodyGyro then bodyGyro:Destroy() end
            end)
        else
            flyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            notify("Fly Mode: OFF", Color3.fromRGB(255, 0, 0))
            settings.flying = false
        end
    end)
    
    createInputButton("Fly Speed", "⚡", 50, function(input)
        local value = tonumber(input.Text)
        if value then
            settings.flySpeed = value
            notify("Fly Speed: " .. value, Color3.fromRGB(0, 200, 255))
        end
    end)
    
    -- SPEED HACK
    local speedBtn = createButton("SPEED HACK", "🏃")
    speedBtn.MouseButton1Click:Connect(function()
        settings.speedHack = not settings.speedHack
        
        if settings.speedHack then
            humanoid.WalkSpeed = settings.walkSpeed
            speedBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
            notify("Speed Hack: ON", Color3.fromRGB(0, 255, 0))
        else
            humanoid.WalkSpeed = 16
            speedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            notify("Speed Hack: OFF", Color3.fromRGB(255, 0, 0))
        end
    end)
    
    createInputButton("Walk Speed", "🏃", 100, function(input)
        local value = tonumber(input.Text)
        if value then
            settings.walkSpeed = value
            if settings.speedHack then humanoid.WalkSpeed = value end
            notify("Walk Speed: " .. value, Color3.fromRGB(0, 200, 255))
        end
    end)
    
    -- NOCLIP
    local noclipBtn = createButton("NOCLIP [N]", "👻")
    noclipBtn.MouseButton1Click:Connect(function()
        settings.noclipping = not settings.noclipping
        
        if settings.noclipping then
            noclipBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
            notify("Noclip: ON", Color3.fromRGB(0, 255, 0))
            
            spawn(function()
                while settings.noclipping do
                    if character then
                        for _, part in pairs(character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                    wait(0.1)
                end
            end)
        else
            noclipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            notify("Noclip: OFF", Color3.fromRGB(255, 0, 0))
        end
    end)
    
    -- INFINITE JUMP
    local infJumpBtn = createButton("INFINITE JUMP", "🚀")
    infJumpBtn.MouseButton1Click:Connect(function()
        settings.infiniteJump = not settings.infiniteJump
        
        if settings.infiniteJump then
            infJumpBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
            notify("Infinite Jump: ON", Color3.fromRGB(0, 255, 0))
        else
            infJumpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            notify("Infinite Jump: OFF", Color3.fromRGB(255, 0, 0))
        end
    end)
    
    UserInputService.JumpRequest:Connect(function()
        if settings.infiniteJump and humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
    
    contentFrame.CanvasSize = UDim2.new(0, 0, 0, contentLayout.AbsoluteContentSize.Y + 20)
end

